# Copy to .env and fill in real values. Never commit .env.

# NYC Open Data (Socrata). Register at https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Census API. Register at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Supabase Postgres connection strings.
# Ingestion (pipeline/) is a long-lived process: use the DIRECT connection (port 5432).
SUPABASE_DB_URL_DIRECT=postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres

# API (api/) runs as short-lived serverless functions: use the transaction POOLER (port 6543).
# See IMPLEMENTATION_PLAN.md Risk R7 for why this distinction matters.
SUPABASE_DB_URL_POOLED=postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres
