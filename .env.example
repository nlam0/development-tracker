# Copy to .env and fill in real values. Never commit .env.

# NYC Open Data (Socrata). Register at https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Census API. Register at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Supabase Postgres connection strings.
# Ingestion (pipeline/) is a long-lived process, so it wants a real session rather than
# transaction-mode pooling -- but GitHub Actions runners have no IPv6 egress and Supabase's
# literal direct-connection host (db.[project-ref].supabase.co) is IPv6-only, so use the
# SESSION-mode pooler (port 5432 via pooler.supabase.com) instead. Var name kept for
# continuity even though it's no longer a literal "direct" connection.
SUPABASE_DB_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# API (api/) runs as short-lived serverless functions: use the TRANSACTION pooler (port 6543).
# See IMPLEMENTATION_PLAN.md Risk R7 for why this distinction matters.
SUPABASE_DB_URL_POOLED=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
